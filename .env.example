# --- Timeworth env ---
# Copy this file to .env.local for local dev

# Gemini (server-only)
GEMINI_API_KEY=""

# Supabase — server (required for prod persistence on Vercel)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Alias accepted: SUPABASE_URL is preferred on server; VITE_ prefix is for client
# SUPABASE_ANON_KEY is also accepted server-side as fallback

# Supabase — client (Vite exposes only VITE_* to browser)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional: override app URL (auto-injected on Vercel as VERCEL_URL)
# Vercel sets VERCEL_URL automatically; no need to configure.
APP_URL=""

# Legacy alias (if you already set these, they still work)
# VITE_GEMINI_API_KEY is NOT used — keep GEMINI_API_KEY server-only
